# ============================================
# 第4周部署密钥配置示例
# 使用方式：cp .env.example .env 然后填写真实值
# ⚠️ .env 已加入 .gitignore，禁止提交到版本库（手册步骤6：密钥不落盘）
# ============================================

# Superset 管理员
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_please
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=change_me_to_a_random_string

# MySQL（数据已在 hive-mysql 容器，只读连接）
MYSQL_HOST=hive-mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ydsh_ads

# Hive
HIVE_HOST=hive-server
HIVE_PORT=10000

# 大模型 API（Streamlit 问答增强，可选）
DEEPSEEK_API_KEY=your_api_key_here
