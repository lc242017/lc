<Slide style={{ width: 1280, height: 720, padding: '60px', background: '#FFFFFF' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A3358' }}>一键部署拉起全栈，ADS 预聚合让查询提速 71%</Text>
      <Box style={{ width: '100%', height: 1, background: '#D3DBE5', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 32, marginTop: 20, marginBottom: 20, flex: 1 }}>
      {/* 左：部署三步 */}
      <Box style={{ flex: 2, flexDirection: 'column', gap: 16, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A3358' }}>部署三步 · docker compose up -d</Text>
        {[
          { n: '1', t: '配置密钥', d: 'cp .env.example .env；密钥注入不落盘' },
          { n: '2', t: '拉起服务', d: 'depends_on + healthcheck 保证依赖顺序' },
          { n: '3', t: '访问验证', d: 'Superset 8088 / App 8501 / 离线大屏双击即开' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 14, background: '#F4F7FB', borderRadius: 8, padding: 16, alignItems: 'center' }}>
            <Box style={{ width: 36, height: 36, borderRadius: 18, background: '#234B80', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{item.n}</Text>
            </Box>
            <Box>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26282E' }}>{item.t}</Text>
              <Text style={{ fontSize: 14, color: '#5F6670', marginTop: 2 }}>{item.d}</Text>
            </Box>
          </Box>
        ))}
        <Box style={{ background: '#EAF0F8', borderLeft: '4px solid #234B80', borderRadius: 4, padding: 14, marginTop: 4 }}>
          <Text style={{ fontSize: 16, color: '#1A3358' }}>安全：密钥 .env 已 gitignore；NL2SQL 走只读账号 + SQL 白名单。</Text>
        </Box>
      </Box>
      {/* 右：压测图 */}
      <Box style={{ flex: 3, background: '#FFFFFF', border: '1px solid #E8ECF2', borderRadius: 10, padding: 12 }}>
        <Chart
          style={{ width: '100%', height: 340 }}
          chartType='barChart'
          barDirection='bar'
          title='查询耗时对比（秒，越低越好）'
          titleColor='#1A3358'
          showLegend={false}
          showDataLabels={true}
          axisColor='#8A97A8'
          dataLabelColor='#26282E'
          colors={['#4A73A8']}
          background='#FFFFFF'
          data={[
            ['查询场景', '耗时'],
            ['全表扫描', 8.572],
            ['分区+列裁剪', 6.081],
            ['分区裁剪', 3.475],
            ['ADS 预聚合', 2.502],
          ]}
        />
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>来源：第4周 benchmark_result.md 真实压测；提速相对全表扫描基线</Text>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>09</Text>
    </Box>
  </Box>
</Slide>
