<Slide style={{ width: 1280, height: 720, padding: '60px', background: '#FFFFFF' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A3358' }}>预测建模：MAPE 16.35%，显著优于两个基线</Text>
      <Box style={{ width: '100%', height: 1, background: '#D3DBE5', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 32, marginTop: 20, marginBottom: 20, flex: 1 }}>
      {/* 左：柱形图 */}
      <Box style={{ flex: 3, background: '#FFFFFF', border: '1px solid #E8ECF2', borderRadius: 10, padding: 12 }}>
        <Chart
          style={{ width: '100%', height: 320 }}
          chartType='barChart'
          barDirection='bar'
          title='测试集 MAPE 对比（%，越低越好）'
          titleColor='#1A3358'
          showLegend={false}
          showDataLabels={true}
          axisColor='#8A97A8'
          dataLabelColor='#26282E'
          colors={['#234B80']}
          background='#FFFFFF'
          data={[
            ['方法', 'MAPE'],
            ['线性回归模型', 16.35],
            ['MA(7) 基线', 34.55],
            ['滞后1期基线', 53.93],
          ]}
        />
      </Box>
      {/* 右：编号说明 */}
      <Box style={{ flex: 2, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
        {[
          { n: '1', t: '方法', d: '加法模型趋势分解（7日中心移动平均）+ 周内季节性；5 特征线性回归，训练 159 天 / 测试 14 天' },
          { n: '2', t: '边界', d: 'R²train 0.7742；大促日 MAPE 达 63.2%，剔除大促后降至 12.75%——促销冲击是主要误差源' },
          { n: '3', t: '口径一致', d: '目标变量直接取同套 ADS 口径 GMV，预测与 ADS 共用唯一口径，解决“指标对不上”' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 14, background: '#F4F7FB', borderRadius: 8, padding: 14 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#234B80' }}>{item.n}</Text>
            <Box>
              <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#26282E', marginBottom: 4 }}>{item.t}</Text>
              <Text style={{ fontSize: 15, color: '#5F6670', lineHeight: 1.5 }}>{item.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>来源：第3周预测建模分析报告（数据源 sqlite ads_kpi_day，本地回退）；MAPE 为测试集实测</Text>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>07</Text>
    </Box>
  </Box>
</Slide>
