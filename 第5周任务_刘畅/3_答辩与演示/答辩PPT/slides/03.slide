<Slide style={{ width: 1280, height: 720, padding: '60px', background: '#FFFFFF' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A3358' }}>从 6 份 CSV 到一体化决策系统</Text>
      <Box style={{ width: '100%', height: 1, background: '#D3DBE5', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'column', gap: 24, marginTop: 20, marginBottom: 20 }}>
      <Text style={{ fontSize: 20, color: '#5F6670', lineHeight: 1.6 }}>解决四个业务痛点：数据分散、口径不一、分析滞后、缺乏预测。五周建成<Text style={{ fontWeight: 'bold', color: '#234B80' }}>一个口径统一的经营分析平台</Text>。</Text>
      {/* 四段式流程 */}
      <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12 }}>
        {[
          { no: '01', t: '数据源', d: '6 份 CSV\n原始订单/用户/商品', c: '#234B80' },
          { no: '02', t: '数仓分层', d: 'ODS→DWD\n→DWS→ADS', c: '#315C91' },
          { no: '03', t: '分析应用', d: '预测 / NL2SQL\n/ 可视化', c: '#4A73A8' },
          { no: '04', t: '部署交付', d: 'Docker 一键\n全栈部署', c: '#82A1C4' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flex: 1, background: '#F4F7FB', borderRadius: 10, padding: 20, flexDirection: 'column', gap: 10, borderTop: `4px solid ${item.c}` }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: item.c }}>{item.no}</Text>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#26282E' }}>{item.t}</Text>
            <Text style={{ fontSize: 16, color: '#5F6670', lineHeight: 1.5 }}>{item.d}</Text>
          </Box>
        ))}
      </Box>
      {/* 结论条 */}
      <Box style={{ background: '#EAF0F8', borderLeft: '4px solid #234B80', borderRadius: 4, padding: 18, marginTop: 8 }}>
        <Text style={{ fontSize: 20, color: '#1A3358', fontWeight: 'bold' }}>所以呢：全链路端到端跑通，每个数字可逐层追溯，全流程可一键复现。</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>来源：第5周端到端联调核对清单</Text>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>03</Text>
    </Box>
  </Box>
</Slide>
