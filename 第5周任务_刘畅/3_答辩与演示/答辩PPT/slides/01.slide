<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF' }}>
  <Box style={{ position: 'relative', width: 1280, height: 720, flexDirection: 'row' }}>
    {/* 左侧深蓝主色块 */}
    <Box style={{ width: 720, height: 720, background: 'linear-gradient(160deg, #1A3358 0%, #234B80 100%)', padding: 60, flexDirection: 'column', justifyContent: 'center' }}>
      <Box style={{ width: 56, height: 4, background: '#82A1C4', marginBottom: 32 }} />
      <Text style={{ fontSize: 18, color: '#82A1C4', letterSpacing: 2, marginBottom: 20 }}>企业项目实战实训 · 综合答辩</Text>
      <Text style={{ fontSize: 54, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.2 }}>云购生活新零售</Text>
      <Text style={{ fontSize: 40, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.25, marginTop: 8 }}>企业级数据仓库与</Text>
      <Text style={{ fontSize: 40, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.25 }}>经营分析可视化系统</Text>
      <Text style={{ fontSize: 20, color: '#C9D8EA', marginTop: 32, lineHeight: 1.5 }}>五周项目成果 · 全流程整合交付</Text>
    </Box>
    {/* 右侧留白 + 信息 */}
    <Box style={{ width: 560, height: 720, background: '#FFFFFF', padding: 60, flexDirection: 'column', justifyContent: 'flex-end' }}>
      <Box style={{ flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 16, color: '#8A97A8', marginBottom: 12 }}>REPORT</Text>
        <Text style={{ fontSize: 28, color: '#234B80', fontWeight: 'bold', lineHeight: 1.4 }}>从原始数据</Text>
        <Text style={{ fontSize: 28, color: '#234B80', fontWeight: 'bold', lineHeight: 1.4 }}>到经营决策</Text>
        <Box style={{ width: 120, height: 1, background: '#D3DBE5', marginTop: 24, marginBottom: 24 }} />
        <Text style={{ fontSize: 17, color: '#5F6670', lineHeight: 1.7 }}>ODS → DWD → DWS → ADS → 预测 / 问数 / 大屏 → 一键部署</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 18, color: '#26282E' }}>汇报人：刘畅</Text>
        <Text style={{ fontSize: 16, color: '#8A97A8' }}>2026 年 11 月 23 日</Text>
      </Box>
    </Box>
  </Box>
</Slide>
