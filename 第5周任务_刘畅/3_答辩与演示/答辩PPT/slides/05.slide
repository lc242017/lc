<Slide style={{ width: 1280, height: 720, padding: '60px', background: '#FFFFFF' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A3358' }}>五周按周递进，每周都有可交付成果</Text>
      <Box style={{ width: '100%', height: 1, background: '#D3DBE5', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'column', marginTop: 24, marginBottom: 24, flex: 1, justifyContent: 'center' }}>
      {/* 时间轴主线 */}
      <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
        {[
          { w: 'W1', t: '采集与预评估', d: 'ODS 贴源 6 表\n质量预评估', c: '#82A1C4' },
          { w: 'W2', t: '清洗与建模', d: '五类脏数据清洗\nDWD 维度建模', c: '#4A73A8' },
          { w: 'W3', t: '汇总与问数', d: 'DWS/ADS KPI\n预测 + NL2SQL', c: '#315C91' },
          { w: 'W4', t: '可视化与部署', d: 'Superset/ECharts\nDocker 一键', c: '#234B80' },
          { w: 'W5', t: '整合与答辩', d: '端到端联调\n五大文档 + PPT', c: '#1A3358' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
            <Box style={{ width: 48, height: 48, borderRadius: 24, background: item.c, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{item.w}</Text>
            </Box>
            <Box style={{ width: 2, height: 24, background: '#D3DBE5' }} />
            <Box style={{ width: '100%', background: '#F4F7FB', borderRadius: 8, padding: 14, minHeight: 150 }}>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26282E', marginBottom: 10 }}>{item.t}</Text>
              <Text style={{ fontSize: 15, color: '#5F6670', lineHeight: 1.5 }}>{item.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
      <Box style={{ background: '#EAF0F8', borderLeft: '4px solid #234B80', borderRadius: 4, padding: 18, marginTop: 28 }}>
        <Text style={{ fontSize: 20, color: '#1A3358', fontWeight: 'bold' }}>所以呢：从"会做技术"到"能交付项目"——五周成果整合成可运行、可复现、可展示的完整系统。</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>来源：第1~5周交付物清单</Text>
      <Text style={{ fontSize: 14, color: '#8A97A8' }}>05</Text>
    </Box>
  </Box>
</Slide>
